{
  "name": "pdf-master-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev --host 127.0.0.1",
    "build": "nuxt build",
    "preview": "nuxt preview --host 127.0.0.1",
    "typecheck": "nuxt typecheck",
    "postinstall": "nuxt prepare",
    "test:browser": "node tests/browser-smoke.mjs",
    "check:catalog": "node --experimental-strip-types tests/catalog-check.mjs",
    "check:fonts": "node --experimental-strip-types tests/font-metrics-check.mjs",
    "generate:api": "openapi-typescript generated/api/public.openapi.json -o generated/api/schema.d.ts",
    "format": "prettier --write app locales generated/api/client.ts generated/api/types.ts nuxt.config.ts",
    "test:preview": "node tests/preview-smoke.mjs",
    "test:auth:ui": "node tests/authentication-ui.mjs",
    "test:auth:email": "node tests/authentication-email.mjs",
    "test:auth:antibot": "node tests/antibot-ui.mjs",
    "test:studio": "node tests/studio-simple-forms.mjs",
    "test:services": "node tests/services-directory.mjs",
    "test:guide": "node tests/prompt-guide.mjs",
    "test:editor": "node tests/editor-workspace.mjs"
  },
  "dependencies": {
    "lucide-vue-next": "0.563.0",
    "nuxt": "4.5.2",
    "pdfjs-dist": "5.4.624",
    "vue": "3.5.43",
    "vue-router": "5.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.58.2",
    "@types/node": "22.19.13",
    "openapi-typescript": "7.13.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3",
    "vue-tsc": "3.2.4"
  },
  "engines": {
    "node": "^22.19.0 || ^24.11.0 || >=26.0.0"
  }
}
